# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500

# Supabase Configuration
# Found in your Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# IMPORTANT: Use the service_role key (server-side ONLY, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Supabase storage bucket name for avatars and post images (must be public or configured)
SUPABASE_STORAGE_BUCKET=vibesta-media

# Direct Postgres Database Connection (Used for Node DB Version Manager / direct pg queries)
# Found in Supabase project settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# JWT Custom Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d
